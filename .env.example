# ─── App ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ─── PostgreSQL ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=worker_db

# ─── RabbitMQ ─────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PREFETCH=5

# ─── Middleware API ───────────────────────────────────────────────────
MIDDLEWARE_API_URL=http://localhost:3000
